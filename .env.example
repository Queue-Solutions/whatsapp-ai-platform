# Server-only values. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
CRON_SECRET=
# Dashboard browser sign-in uses this public Supabase key (sb_publishable_...).
# This is NOT the Supabase secret key and is NOT the OpenAI key.
SUPABASE_PUBLISHABLE_KEY=
# Hosted AI needs these server values in Vercel; a local key is only for local AI runs.
# Echo is the default until the bounded-AI migration and acceptance checks are complete.
WHATSAPP_REPLY_MODE=echo
OPENAI_API_KEY=
# Temporarily enables the authenticated, fixed-fixture AI checks (no WhatsApp sends).
AI_ACCEPTANCE_ENABLED=false
# Optional Photon-compatible city geocoder. Public demo is suitable for low-volume test traffic;
# use your own hosted Photon endpoint before scaling. No API key is required by the default.
GEOCODER_URL=https://photon.komoot.io/api/

# IRAM company-number connection. The dashboard manages approved recipients.
WHATSAPP_PILOT_ENABLED=false
WHATSAPP_PILOT_SEND_ENABLED=false
WHATSAPP_PILOT_TENANT_ID=
WHATSAPP_PILOT_APP_ID=
WHATSAPP_PILOT_CONFIG_ID=
WHATSAPP_PILOT_PHONE_NUMBER_ID=
WHATSAPP_PILOT_APP_SECRET=
WHATSAPP_PILOT_VERIFY_TOKEN=
WHATSAPP_PILOT_ACCESS_TOKEN=
WHATSAPP_PILOT_GRAPH_API_VERSION=
