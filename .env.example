# Server-only values. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Meta App settings > Basic. Different from the access token and verify token.
META_APP_SECRET=
# Generate a random string and use the same value in Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Copy the Graph version shown in your Meta API testing panel, e.g. v24.0.
META_GRAPH_API_VERSION=v24.0
WHATSAPP_ACCESS_TOKEN=
# Only the Phone Number ID of Meta's temporary test number.
WHATSAPP_TEST_PHONE_NUMBER_ID=
# Your verified test recipient wa_id, country code + digits, no plus or spaces.
WHATSAPP_TEST_RECIPIENTS=
# This foundation deliberately rejects any other mode.
WHATSAPP_MODE=test
CRON_SECRET=
# Used by the signed webhook simulator, never by production routes.
SMOKE_BASE_URL=http://localhost:3000
# Dashboard browser sign-in uses this public Supabase key (sb_publishable_...).
# This is NOT the Supabase secret key and is NOT the OpenAI key.
SUPABASE_PUBLISHABLE_KEY=
